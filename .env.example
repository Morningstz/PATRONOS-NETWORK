# ───────── Database (Supabase Postgres or local Postgres) ─────────
# Pooled connection for the app (Supabase: port 6543, ?pgbouncer=true)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/patronos"
# Direct connection for migrations (Supabase: port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/patronos"

# ───────── Auth ─────────
# "dev"      → local only: pick a seeded DEMO user, no password. Refused on Vercel/production.
# "supabase" → Supabase Auth (magic link). Required for any deployed environment.
AUTH_MODE="dev"
# 32+ random characters. Generate: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-string-at-least-32-chars"

NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Never expose this to the browser. Only needed for future storage/admin tasks.
SUPABASE_SERVICE_ROLE_KEY=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ───────── Security ─────────
# Salt for one-way hashing of IP addresses (rate limiting, ad-fraud filtering). 16+ chars.
IP_HASH_SALT="replace-with-random-salt"
# Cloudflare Turnstile (bot protection). Leave empty locally; REQUIRED in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Upstash Redis REST (shared rate limiting across serverless instances). REQUIRED in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ───────── Payments (milestone 2) ─────────
# v1 uses a mock provider only. Do not add real Stripe keys until approval + security review.
PAYMENT_PROVIDER="mock"

# ───────── Monitoring (optional) ─────────
SENTRY_DSN=""
